99f2063f7f1f20e5c0e3e635f42b2df\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.template.properties.spec.type=2958d416d08aa5a472d7b509036cb7eafd542add84527e66a145ea64cb4cdc75\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.template.required.#=6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.template.required.0=d4f02eaafd1a9e9de7d10972ca8e47fa7a985825c3c9c1e249c72683cb3e4f19\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.template.type=2958d416d08aa5a472d7b509036cb7eafd542add84527e66a145ea64cb4cdc75\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.weight.description=3b9cd8a98cb72dd4da83f332656bdf4a5038a50e185f3822259867330e74904e\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.weight.format=05c312945775207c10ccb6135f22782e5434f66a742f009c01b33597509bf953\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.weight.maximum=ad57366865126e55649ecb23ae1d48887544976efea46a48eb5d85a6eeb4d306\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.weight.minimum=6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b\nspec.versions.1.schema.openAPIV3Schema.properties.spec.properties.weight.type=2dba2454d80024acf67141fe5efe7a6772a3f0c92273ea2f26f0ae742bcafc25\nspec.versions.1.schema.openAPIV3Schema.properties.spec.required.#=6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b\nspec.versions.1.schema.openAPIV3Schema.properties.spec.required.0=5cde0f1298f41f7d1c8b907a36992a7a513225a2615bd6e307bf1a9149b06b40\nspec.versions.1.schema.openAPIV3Schema.properties.spec.type=2958d416d08aa5a472d7b509036cb7eafd542add84527e66a145ea64cb4cdc75\nspec.versions.1.schema.openAPIV3Schema.properties.status.description=2ac0db37d1577008657ae2300855d4eafb52341163b207902e1e6e03885ff731\nspec.versions.1.schema.openAPIV3Schema.properties.status.properties.conditions.description=e5b7