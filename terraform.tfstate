            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"pricing:GetProducts\",\n        \"ec2:DescribeSubnets\",\n        \"ec2:DescribeSpotPriceHistory\",\n        \"ec2:DescribeSecurityGroups\",\n        \"ec2:DescribeLaunchTemplates\",\n        \"ec2:DescribeInstances\",\n        \"ec2:DescribeInstanceTypes\",\n        \"ec2:DescribeInstanceTypeOfferings\",\n        \"ec2:DescribeImages\",\n        \"ec2:DescribeAvailabilityZones\",\n        \"ec2:CreateTags\",\n        \"ec2:CreateLaunchTemplate\",\n        \"ec2:CreateFleet\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:TerminateInstances\",\n        \"ec2:DeleteLaunchTemplate\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"ec2:ResourceTag/karpenter.sh/discovery\": \"eks11\"\n        }\n      }\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": \"arn:aws:ec2:*:509399612661:launch-template/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"ec2:ResourceTag/karpenter.sh/discovery\": \"eks11\"\n        }\n      }\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"ec2:RunInstances\",\n      \"Resource\": [\n        \"arn:aws:ec2:*::snapshot/*\",\n        \"arn:aws:ec2:*::image/*\",\n        \"arn:aws:ec2:*:509399612661:volume/*\",\n        \"arn:aws:ec2:*:509399612661:subnet/*\",\n        \"arn:aws:ec2:*:509399612661:spot-instances-request/*\",\n        \"arn:aws:ec2:*:509399612661:security-group/*\",\n        \"arn:aws:ec2:*:509399612661:network-interface/*\",\n        \"arn:aws:ec2:*:509399612661:instance/*\"\n      ]\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"ssm:GetParameter\",\n      \"Resource\": \"arn:aws:ssm:*:*:parameter/aws/service/*\"\n    },\n    {\n      \"Effect\": \"Allow\",